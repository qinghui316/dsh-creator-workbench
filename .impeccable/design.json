  "narrative": {
    "northStar": "原生创作工具",
    "overview": "这是一套在 Windows DSH Desktop 中完成内容整理与编辑的操作界面。视觉延续宿主的文字、主题和按钮语言，以简洁的 Beaver 式表单分组、连续历史列表和真实媒体预览组织任务。密度紧凑，标题克制，主要动作通过原生按钮与清晰文案建立层级。\n\n本文件记录当前工作区源码中可复用的视觉与交互规则，面向 Windows 原生操作场景。宿主提供字体与主题变量，插件不另建固定品牌色或字体栈。原生对话与业务区的分栏、业务区左侧项目历史与右侧详情，是承载这套视觉系统的现有布局。通用文章、图片与各平台发布材料沿用同一项目上下文，通过分组、连续行和就地编辑区呈现。",
    "keyCharacteristics": [
      "继承宿主语义主题，使用文字层级、细分隔线与轻背景表达关系。",
      "正文、说明与详情标题形成紧凑的三级文字关系。",
      "表单纵向分组，次要与诊断信息通过折叠展开。",
      "项目历史和平台材料以连续行组织，图片、视频与封面保留真实比例。",
      "预览和版本内容在所属业务区内展开。",
      "原生请求、编辑保存与后台任务分别显示各自状态。"
    ],
    "rules": [
      {
        "name": "The Host Theme Rule",
        "body": "复用宿主语义变量；扩展界面时继续按角色取色，不从截图采样并写入固定色值。",
        "section": "colors"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "用正文、说明、分组与详情标题的既有角色区分层级；同层内容保持一致的字号与字重。",
        "section": "typography"
      },
      {
        "name": "The Owning Container Rule",
        "body": "响应式变化由实际业务容器决定；同时保留原生对话与业务区、项目栏与详情的关系，局部预览在所属业务区中展开。",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "业务分组保持平面；轻投影服务于浮起的动作菜单。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 使用宿主语义颜色、字体与原生按钮，让新增表单延续当前控件语言。",
      "**Do** 按正文、说明、分组标题和详情标题角色建立紧凑层级。",
      "**Do** 用连续行、分隔线和折叠组织历史、管理与诊断内容。",
      "**Do** 按所属容器宽度重排封面、图片与表单内部内容，并保留真实媒体比例。",
      "**Do** 同时保留原生分栏、项目栏与详情，以及“概览 → 视频 → 脚本 → 字幕 → 文章”的顺序。",
      "**Do** 分别显示请求准备、内容保存和后台任务状态，让反馈对应实际动作。"
    ],
    "donts": [
      "**Don't** 从单张浅色截图推导固定主题色或自行指定宿主字体。",
      "**Don't** 让局部预览遮住原生导航或对话区。",
      "**Don't** 用装饰性大标题或密集卡片边框替换当前紧凑表单与连续行。",
      "**Don't** 以窄容器为由隐藏项目栏或把项目与详情改成互斥页面。",
      "**Don't** 为局部界面调整全局字体、字号或缩放。"
    ]
  }
}
