  "components": [
    {
      "name": "原生动作组",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "保存、导入与返回沿用 DSH small 层级；浅色增强次要按钮边界及悬停/按下反馈。片段展示已批准的浅色动作状态，深色仍使用宿主。",
      "html": "<div class=\"ds-actions\" data-ds-light-example=\"true\"><button class=\"ds-button ds-primary\" type=\"button\">保存</button><button class=\"ds-button ds-secondary\" type=\"button\">导入</button><button class=\"ds-button ds-ghost\" type=\"button\">返回</button></div>",
      "css": ".ds-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px}.ds-button{display:inline-flex;align-items:center;justify-content:center;gap:4px;height:28px;padding:0 10px;border:0;border-radius:var(--dsw-radius-sm);font-size:12px;line-height:18px;cursor:pointer;color:var(--dsw-alias-label-primary)}.ds-primary{background:var(--dsw-alias-button-primary-fill);color:var(--dsw-alias-label-primary-foreground)}.ds-primary:hover:not(:disabled){background:var(--dsw-alias-button-primary-hover)}.ds-secondary{border:.5px solid var(--dsw-alias-border-l3);background:transparent}.ds-ghost{background:transparent}.ds-secondary:hover:not(:disabled),.ds-ghost:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover)}.ds-ghost:active:not(:disabled){background:var(--dsw-alias-interactive-bg-active)}.ds-button:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}.ds-button:disabled{opacity:.4;cursor:not-allowed} .ds-actions[data-ds-light-example=true]{--dsw-alias-interactive-bg-hover:#e3eaf5;--dsw-alias-interactive-bg-active:#d3dfef}.ds-actions[data-ds-light-example=true] .ds-secondary{border:1px solid #8792a4;background:var(--dsw-alias-bg-base)}.ds-actions[data-ds-light-example=true] .ds-ghost{border:1px solid transparent}.ds-actions[data-ds-light-example=true] :is(.ds-secondary,.ds-ghost):hover:not(:disabled){border-color:#8792a4;background:#e3eaf5}.ds-actions[data-ds-light-example=true] :is(.ds-secondary,.ds-ghost):active:not(:disabled){background:#d3dfef}"
    },
    {
      "name": "设置字段",
      "kind": "input",
      "refersTo": "field",
      "description": "标签、输入与说明纵向分组；设置输入最小高度36px。浅色有效可用字段悬停强调边界，aria-invalid错误边框及禁用状态保持。",
      "html": "<label class=\"ds-field\"><span>生图模型</span><input value=\"\" placeholder=\"输入模型名称\" /><span class=\"ds-helper\">使用服务提供的模型名称</span></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;min-width:0;font-size:13px;line-height:20px;color:var(--dsw-alias-label-primary)}.ds-field input{width:100%;min-width:0;min-height:36px;padding:7px 10px;border:1px solid var(--dsw-alias-border-l2,var(--dsw-alias-border-l1));border-radius:6px;color:var(--dsw-alias-label-primary);background:var(--dsw-alias-bg-base);font:inherit}.ds-field input:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}.ds-field input[aria-invalid=true]{border-color:var(--dsw-alias-state-error-primary)}.ds-helper{color:var(--dsw-alias-label-secondary)}:host-context(html[style*=\"color-scheme: light\"]) .ds-field input:hover:not(:disabled):not([aria-invalid=true]){border-color:var(--dsw-alias-state-business-primary)}"
    },
    {
      "name": "详情页签",
      "kind": "nav",
      "refersTo": "detail-tab",
      "description": "七页签顺序固定，以按钮自身下划线和文字表示当前页；选中或聚焦时仅滚动所属导航。",
      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"项目内容\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\" tabindex=\"0\" type=\"button\">概览</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" type=\"button\">视频</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" type=\"button\">脚本</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" type=\"button\">字幕</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" type=\"button\">文章</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" type=\"button\">图片</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" type=\"button\">发布</button></div>",
      "css": ".ds-tabs{position:relative;display:flex;gap:12px;margin-top:4px;padding-bottom:2px;overflow-x:auto}.ds-tab{position:relative;flex:none;min-height:36px;padding:0 6px 8px;border:0;border-radius:6px 6px 0 0;background:transparent;font-size:13px;line-height:16px;font-weight:500;color:var(--dsw-alias-label-tertiary);white-space:nowrap;cursor:pointer}.ds-tab:first-child{padding-left:0}.ds-tab::after{content:\"\";position:absolute;left:6px;right:6px;bottom:1px;height:2px;background:transparent}.ds-tab:first-child::after{left:0}.ds-tab[aria-selected=true]{color:var(--dsw-alias-state-business-primary)}.ds-tab[aria-selected=true]::after{background:var(--dsw-alias-state-business-primary)}.ds-tab:hover{background:var(--dsw-alias-interactive-bg-hover)}.ds-tab:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:-2px}"
    },
    {
      "name": "设置分组导航",
      "kind": "nav",
      "description": "生图服务、发布平台、语音转文字、公众号与常规设置使用统一分组导航，当前组为轻背景选中态。",
      "html": "<nav class=\"ds-settings-tabs\" aria-label=\"设置分组\"><button type=\"button\" aria-current=\"page\">生图服务</button><button type=\"button\">发布平台</button><button type=\"button\">语音转文字</button><button type=\"button\">公众号</button><button type=\"button\">常规</button></nav>",
      "css": ".ds-settings-tabs{display:flex;overflow-x:auto;overflow-x:auto;overflow-x:auto;gap:4px;margin-bottom:20px;border-bottom:1px solid var(--dsw-alias-border-l1);padding-bottom:10px}.ds-settings-tabs button{border:0;background:none;color:var(--dsw-alias-label-secondary);padding:8px 12px;border-radius:6px;cursor:pointer;font:inherit;white-space:nowrap}.ds-settings-tabs [aria-current]{background:var(--dsw-alias-interactive-bg-hover);color:var(--dsw-alias-label-primary);font-weight:600}.ds-settings-tabs button:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}"
    },
    {
      "name": "资产行",
      "kind": "custom",
      "description": "视频管理等资产列表使用连续行、文字与行内动作。",
      "html": "<div class=\"ds-asset-row\"><div class=\"ds-row-copy\"><span class=\"ds-file-name\">视频文件.mp4</span><span class=\"ds-muted\">当前视频</span></div><button class=\"ds-row-action\" type=\"button\">操作</button></div>",
      "css": ".ds-asset-row{display:flex;align-items:center;flex-wrap:wrap;gap:10px;min-width:0;padding:10px 0;border-bottom:1px solid var(--dsw-alias-border-l1);font-size:13px;color:var(--dsw-alias-label-primary)}.ds-row-copy{display:flex;flex-direction:column;gap:3px;flex:1;min-width:100px}.ds-file-name{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-muted{color:var(--dsw-alias-label-secondary);font-size:13px;line-height:20px}.ds-row-action{padding:5px 8px;cursor:pointer;border:0;border-radius:5px;color:var(--dsw-alias-label-secondary);background:transparent;font-size:13px}.ds-row-action:hover{background:var(--dsw-alias-interactive-bg-hover)}.ds-row-action:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}"
    },
    {
      "name": "平台材料选择与编辑",
      "kind": "custom",
      "description": "持续平台导航、紧凑账号、当前材料选择与一层材料操作菜单；正文编辑优先，新建与复制按需进入。",
      "html": "<section class=\"ds-publishing\"><nav aria-label=\"发布平台\"><button aria-current=\"page\">小红书</button><button>抖音</button><button>B站</button></nav><p>发布账号 · 已连接</p><div class=\"ds-material\"><label>发布内容<select><option>当前图文材料</option></select></label><button aria-haspopup=\"menu\">材料操作</button></div><p>已保存</p><label>正文<textarea rows=\"4\">当前平台文案</textarea></label></section>",
      "css": ".ds-publishing{color:var(--dsw-alias-label-primary);font-size:13px}.ds-publishing nav,.ds-material{display:flex;flex-wrap:wrap;gap:8px;align-items:end}.ds-publishing nav{padding-bottom:12px;border-bottom:1px solid var(--dsw-alias-border-l1)}.ds-publishing button{padding:6px 10px;border:1px solid var(--dsw-alias-border-l2);border-radius:6px;background:transparent;color:inherit;font:inherit}.ds-publishing [aria-current]{background:var(--dsw-alias-bg-layer-2);color:var(--dsw-alias-state-business-primary)}.ds-publishing label{display:grid;gap:6px;flex:1;min-width:0}.ds-publishing :is(select,textarea){box-sizing:border-box;width:100%;min-height:36px;padding:7px 10px;border:1px solid var(--dsw-alias-border-l2);border-radius:6px;background:var(--dsw-alias-bg-base);color:inherit;font:inherit}.ds-publishing p{color:var(--dsw-alias-label-secondary);margin:12px 0}"
    },
    {
      "name": "脚本请求与保存反馈",
      "kind": "custom",
      "description": "请求准备与脚本自动保存分别反馈；请求就绪后由用户在原生项目对话发送。片段展示就绪和已保存。",
      "html": "<section class=\"ds-script-feedback\" aria-label=\"脚本\"><button class=\"ds-script-request\" type=\"button\">让 Agent 修改脚本</button><p class=\"ds-request-state\" role=\"status\">请求已放入左侧对话，请发送。</p><div class=\"ds-script-save\" role=\"status\">已保存</div></section>",
      "css": ".ds-script-feedback{min-width:0;color:var(--dsw-alias-label-primary);font:var(--dsw-font-markdown-base)}.ds-script-request{display:inline-flex;align-items:center;justify-content:center;height:28px;padding:0 10px;border:.5px solid var(--dsw-alias-border-l3);border-radius:var(--dsw-radius-sm);background:transparent;color:var(--dsw-alias-label-primary);font-size:12px;line-height:18px;cursor:pointer}.ds-script-request:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover)}.ds-script-request:disabled{opacity:.4;cursor:not-allowed}.ds-request-state{margin:0;font-size:13px;line-height:20px;color:var(--dsw-alias-label-secondary)}.ds-script-save{display:flex;align-items:center;gap:10px;min-height:36px;margin-bottom:10px;font-size:13px;color:var(--dsw-alias-label-secondary)}.ds-script-request:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}"
    },
    {
      "name": "概览成果分组",
      "kind": "custom",
      "description": "概览直接观看当前视频、真实正文摘录、图片与封面；发布内容逐份展示平台和状态。管理与编辑进入对应页面，点击媒体留在业务区查看。片段展示视频和脚本成果。",
      "html": "<div class=\"ds-overview\"><section class=\"ds-overview-section\" aria-label=\"视频摘要\"><div class=\"ds-overview-heading\"><h3>视频</h3><button type=\"button\">管理</button></div><video class=\"ds-overview-video\" controls preload=\"metadata\" aria-label=\"概览视频预览\"></video><p class=\"ds-overview-caption\">创作演示.mp4</p></section><section class=\"ds-overview-section\" aria-label=\"脚本摘要\"><div class=\"ds-overview-heading\"><h3>脚本</h3><button type=\"button\">编辑</button></div><p class=\"ds-overview-excerpt\">先整理本期主题与资料，再写出口播结构。拍摄完成后导入成片，继续准备图片、文章和各平台内容。</p></section><section class=\"ds-overview-section\" aria-label=\"文章摘要\"><div class=\"ds-overview-heading\"><h3>文章</h3><button type=\"button\">编辑</button></div><h4>从选题到成稿</h4><p class=\"ds-overview-excerpt\">把素材按主题整理，将共用成果与各平台发布内容分别保存。</p></section></div>",
      "css": ".ds-overview{padding:4px 0 20px;color:var(--dsw-alias-label-primary);font:var(--dsw-font-markdown-base)}.ds-overview-section{padding:20px 0;border-bottom:1px solid var(--dsw-alias-border-l1);min-width:0}.ds-overview-section:first-child{padding-top:0}.ds-overview-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.ds-overview-heading h3{margin:0;font-size:14px;font-weight:600}.ds-overview-heading button{height:28px;padding:0 10px;border:0;border-radius:var(--dsw-radius-sm);background:transparent;color:var(--dsw-alias-label-primary);font-size:12px;line-height:18px;cursor:pointer}.ds-overview-heading button:hover{background:var(--dsw-alias-interactive-bg-hover)}.ds-overview-heading button:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}.ds-overview-video{display:block;width:100%;max-height:280px;aspect-ratio:16/9;background:var(--dsw-alias-bg-overlay);border-radius:6px}.ds-overview-caption{margin:8px 0 0;color:var(--dsw-alias-label-secondary);font-size:12px;overflow-wrap:anywhere}.ds-overview-section h4{margin:0 0 8px;font-size:14px;line-height:1.6;font-weight:500;overflow-wrap:anywhere}.ds-overview-excerpt{margin:0;line-height:1.75;font-size:13px;white-space:pre-line;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;overflow:hidden}"
    },
    {
      "name": "文章文稿与版本保存",
      "kind": "custom",
      "description": "当前文章以版本、编辑和去发布为主，创建、导入及HTML成品进入更多菜单。编辑态突出保存新版本，文稿与预览切换保留原格式和输入。",
      "html": "<section class=\"ds-article\" aria-label=\"文章文稿\"><div class=\"ds-article-toolbar\"><button type=\"button\" aria-pressed=\"true\">文稿</button><button type=\"button\">预览</button><button class=\"ds-article-save\" type=\"button\">保存新版本</button><span>Markdown</span></div><textarea class=\"ds-source\" aria-label=\"文章源稿\"># 从选题到成稿\n\n整理观点，完成正文，再为各平台准备独立材料。</textarea><p class=\"ds-save-status\" role=\"status\">修改尚未保存</p></section>",
      "css": ".ds-article{display:flex;flex-direction:column;min-width:0;min-height:0;height:100%;gap:14px;color:var(--dsw-alias-label-primary);font:var(--dsw-font-markdown-base)}.ds-article-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:8px}.ds-article-toolbar button{height:28px;padding:0 10px;border:.5px solid var(--dsw-alias-border-l3);border-radius:var(--dsw-radius-sm);background:transparent;color:inherit;font-size:12px;line-height:18px;cursor:pointer}.ds-article-toolbar button.ds-article-save{border:0;background:var(--dsw-alias-button-primary-fill);color:var(--dsw-alias-label-primary-foreground)}.ds-article-toolbar button:hover{background:var(--dsw-alias-interactive-bg-hover)}.ds-article-toolbar button.ds-article-save:hover{background:var(--dsw-alias-button-primary-hover)}.ds-source{box-sizing:border-box;width:100%;min-height:240px;flex:1;resize:vertical;padding:14px;border:1px solid var(--dsw-alias-border-l1);border-radius:6px;background:var(--dsw-alias-bg-base);color:inherit;font:inherit;font-size:14px;line-height:1.7;tab-size:2}.ds-save-status,.ds-article-toolbar span{margin:0;min-height:20px;font-size:13px;line-height:20px;color:var(--dsw-alias-label-secondary)}.ds-article button:focus-visible,.ds-source:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}"
    },
    {
      "name": "项目图片网格",
      "kind": "custom",
      "description": "项目图片在所属业务区分组浏览；点击图片进入DSH内容视口中央图片层，预览与移除分开。",
      "html": "<section class=\"ds-gallery\" aria-label=\"项目图片\"><div class=\"ds-image-item\"><button class=\"ds-image-button\" type=\"button\" aria-label=\"预览项目图片\"><span>读取图片…</span></button><div class=\"ds-image-meta\"><span>1024×1365</span><button type=\"button\">移除</button></div></div><div class=\"ds-image-item\"><button class=\"ds-image-button\" type=\"button\" aria-label=\"预览项目图片\"><span>读取图片…</span></button><div class=\"ds-image-meta\"><span>1536×1024</span><button type=\"button\">移除</button></div></div></section>",
      "css": ".ds-gallery{container-type:inline-size;display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:12px;margin:14px 0;color:var(--dsw-alias-label-primary)}.ds-image-item{min-width:0}.ds-image-button{display:block;width:100%;min-height:130px;padding:0;border:0;border-radius:8px;background:var(--dsw-alias-bg-layer-2);color:var(--dsw-alias-label-secondary);font:inherit;cursor:pointer}.ds-image-meta{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-top:5px;font-size:12px;color:var(--dsw-alias-label-secondary)}.ds-image-meta button{height:28px;padding:0 10px;border:0;border-radius:var(--dsw-radius-sm);background:transparent;color:inherit;font-size:12px;cursor:pointer}.ds-image-meta button:hover{background:var(--dsw-alias-interactive-bg-hover)}.ds-gallery button:focus-visible{outline:2px solid var(--dsw-alias-state-business-primary);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "原生创作工具",
    "overview": "**Creative North Star: \"原生创作工具\"**\n\n这是一套在 Windows DSH Desktop 中完成内容整理与编辑的操作界面。视觉延续宿主的文字、主题和按钮语言，以简洁的 Beaver 式表单分组、连续历史列表和真实媒体预览组织任务。密度紧凑，标题克制，主要动作通过原生按钮与清晰文案建立层级。\n\n本文件记录 0.7.2 工作区源码中可复用的视觉与交互规则，面向 Windows 原生操作场景。宿主提供字体与主题变量，插件不另建字体栈。原生对话与业务区的分栏、业务区左侧项目历史与右侧详情继续承载现有流程。概览呈现已有成果，各页负责对应内容；共用成果和平台材料保持独立。实际检查及安装结果记录在 workbench-ui-consistency-repair Change。",
    "keyCharacteristics": [
      "继承宿主语义主题，浅色局部增强分区、边界、悬停与选中关系。",
      "正文、说明与详情标题形成紧凑的三级文字关系。",
      "概览按成果分组直接观看视频、图片、正文摘录和各平台状态，编辑时进入所属页面。",
      "常用内容与操作直接展示，历史记录和诊断按需展开。",
      "项目历史和平台材料以连续行组织，图片、视频与封面保留真实比例。",
      "文章阅读、源稿编辑和版本保存各有明确状态；共用成果与平台材料分别编辑。",
      "原生请求、编辑保存与后台任务分别反馈，后台更新保留未保存输入。"
    ],
    "rules": [
      {
        "name": "The Host Theme Rule",
        "body": "基础界面复用宿主语义变量；浅色对比度增强使用本插件已批准的六个局部角色，作用范围限定在工作台内。",
        "section": "colors"
      },
      {
        "name": "The Quiet Hierarchy Rule",
        "body": "用正文、说明、分组与详情标题的既有角色区分层级；同层内容保持一致的字号与字重。",
        "section": "typography"
      },
      {
        "name": "The Owning Container Rule",
        "body": "响应式变化由实际业务容器决定；同时保留原生对话与业务区、项目栏与详情的关系，正文编辑和辅助面板在所属业务区内展开，图片查看使用居中的视口弹层。",
        "section": "layout"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "业务分组保持平面；轻投影服务于浮起的动作菜单。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 使用宿主语义颜色、字体与原生按钮，让新增表单延续当前控件语言。",
      "**Do** 按正文、说明、分组标题和详情标题角色建立紧凑层级。",
      "**Do** 在概览直接呈现真实成果，编辑时进入对应页面，历史与诊断按需查看。",
      "**Do** 按所属容器宽度重排封面、图片与表单内部内容，并保留真实媒体比例。",
      "**Do** 同时保留原生分栏、项目栏与详情，以及“概览 → 视频 → 脚本 → 字幕 → 文章 → 图片 → 发布”的顺序。",
      "**Do** 分别显示请求准备、内容保存和后台任务状态，让反馈对应实际动作。",
      "**Do** 分开共用成果、页面草稿与平台材料，后台更新时保留正在编辑的内容。"
    ],
    "donts": [
      "**Don't** 从单张浅色截图推导固定主题色或自行指定宿主字体。",
      "**Don't** 让辅助编辑面板越出业务区；图片弹层关闭后恢复原界面与焦点。",
      "**Don't** 用装饰性大标题或密集卡片边框替换当前紧凑表单与连续行。",
      "**Don't** 以窄容器为由隐藏项目栏或把项目与详情改成互斥页面。",
      "**Don't** 为局部界面调整全局字体、字号或缩放。"
    ]
  }
}
